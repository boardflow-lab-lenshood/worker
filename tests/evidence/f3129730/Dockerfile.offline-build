# Local acceptance build: cached SDK, public packages downloaded on the host,
# and the exact baseline's cached .NET 7 runtime. No build network is required.
FROM mcr.microsoft.com/dotnet/sdk:7.0 AS build
WORKDIR /source
COPY packages /packages
COPY Worker.csproj Program.cs ./
RUN dotnet restore -a arm64 --source /packages
RUN dotnet publish -c release -o /app -a arm64 --self-contained false --no-restore
FROM boardflow-real-uat/worker:c955288f250cfc4edf74675e106859aff56c6c60
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "Worker.dll"]
